<?xml version="1.0"?>
<package format="3">
  <name>chassis_communication</name>
  <version>0.1.0</version>
  <description>Keyboard cmd_vel control and a two-wheel int32 UART bridge.</description>
  <maintainer email="maintainer@example.com">Chassis Maintainer</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
